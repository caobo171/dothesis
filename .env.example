# OpenDraft Configuration
# Copy this file to .env and add your API keys

# ---------------------------------------------------------------------------
# AI models — required: at least one provider key
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_API_KEY=your-gemini-api-key   # alias used by some langchain integrations

# Optional: additional models
# ANTHROPIC_API_KEY=your-claude-api-key
# OPENAI_API_KEY=your-openai-api-key

# Optional: fallback Gemini API keys for rate-limit resilience
# GOOGLE_API_KEY_FALLBACK=your-fallback-key
# GOOGLE_API_KEY_FALLBACK_2=your-second-fallback-key
# GOOGLE_API_KEY_FALLBACK_3=your-third-fallback-key

# ---------------------------------------------------------------------------
# Orchestrator — chat surface + M1-M5 module agents (sub-project 1)
# ---------------------------------------------------------------------------
# dev.sh defaults this to true. Set to false to mount only the legacy wizard API.
ORCHESTRATOR_ENABLED=true

# Override the default LLM model used by every agent / tool. Empty = uses the
# code default (gemini-2.5-flash). Set this if Google deprecates the default
# (see https://ai.google.dev/gemini-api/docs/models) so you don't have to edit code.
# ORCHESTRATOR_LLM_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# LangSmith observability — full trace of every LLM call + graph node
# ---------------------------------------------------------------------------
# 1) Get a free API key at https://smith.langchain.com/settings (free tier
#    = 5k traces/mo, enough for dev. Paid Plus = 100k for $39/mo).
# 2) Paste below. dev.sh auto-enables tracing when LANGSMITH_API_KEY is set.
# 3) In production, leave LANGSMITH_TRACING unset (or =false) and only enable
#    for debugging sessions, OR set LANGSMITH_SAMPLING_RATE=0.1 to sample
#    10% of traces to stay under quota.
# 4) Tracing failures NEVER affect runtime — traces are fire-and-forget.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dothesis-dev
# LANGSMITH_TRACING=true                # set by dev.sh when key is present
# LANGSMITH_SAMPLING_RATE=0.1           # prod sampling (omit to trace every call)
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # override for EU region etc.

# ---------------------------------------------------------------------------
# Database, storage, auth — see docs/superpowers/plans/2026-05-23-web-engine-mvp.md
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://opendraft:opendraft@localhost:5499/opendraft
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# SESSION_SECRET=replace-with-random-string
