# DoThesis configuration — copy to .env and fill in.
# Variable names below match what the code actually reads (api/app/settings.py
# + engine/orchestrator os.environ lookups). Anything marked REQUIRED has no
# default: the API process fails to boot if it is missing.

# ===========================================================================
# REQUIRED
# ===========================================================================

# --- Database (SQLAlchemy + psycopg3 driver — note the `+psycopg` scheme) ---
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dothesis

# --- Auth: secret used to sign session/JWT tokens. Use a long random value:
#     openssl rand -hex 32
SESSION_SECRET=replace-with-32-bytes-hex

# --- Object storage (uploads + exported DOCX/PDF) ---
# S3_BUCKET is the canonical name the API requires. (Some engine/orchestrator
# paths also accept a legacy AWS_S3_BUCKET fallback, but set S3_BUCKET — it
# covers every code path.)
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_REGION=us-east-1
# Key prefix inside the bucket (trailing slash auto-added). Default: dothesis/
S3_PREFIX=dothesis/

# --- AI model provider / routing ---
# Two routes (agent/model_factory.py + orchestrator/llm.py):
#   native — the provider's own SDK (Gemini/Anthropic). Preserves prompt caching.
#   ofox   — the Ofox gateway (https://api.ofox.ai/v1), one key -> many models,
#            provider/model ids (e.g. bailian/qwen-plus, google/gemini-2.5-flash).
# Leave the two ROUTE vars unset (or =native) for the native Gemini default.
#
# Native keys — needed for route=native, and still used as a vision fallback.
# Set BOTH: api/settings reads GEMINI_API_KEY; engine/langchain reads GOOGLE_API_KEY.
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-gemini-api-key
#
# Ofox gateway (route=ofox). Get a key at https://ofox.ai (fund the balance or
# calls 402). One key covers the agent brain, the engine, and vision.
#
# Uncomment the ROUTE lines and you are done: the ofox default model is
# bailian/qwen-plus on BOTH the brain (agent/model_factory.spec_from_env) and the
# engine (orchestrator/llm.resolve_orchestrator_model), so a partial uncomment can
# no longer land you on a different (pricier) model than this file advertises. That
# split is how the billing bug used to fire — the route line alone got uncommented
# and the code default was google/gemini-2.5-flash, which Ofox resells at 0.30/2.50
# (~3.24x the credit baseline), not the 0.15/0.60 native rate the billing assumed.
# The engine had the same footgun in the other direction: ORCHESTRATOR_LLM_ROUTE=ofox
# without ORCHESTRATOR_LLM_MODEL used to send the gateway the unprefixed native id
# "gemini-2.5-flash". Both model vars below are therefore OPTIONAL — they only
# pin/override; the route alone is a complete, coherent config.
#
# ⚠️ SHIP-TOGETHER: flipping this route is the deploy half of the credit_multiplier
# correction (f64bf79). That correction bills the native default gemini-3.5-flash at
# ~12.86x while PACKAGES are sized on "1 pack ≈ 1 run" (≈1/13 of a run per pack).
# Do not deploy that multiplier change while the live default is still 3.5-flash —
# the route flip to ofox + qwen-plus (~0.62x) must ship in the SAME deployment.
# OFOX_API_KEY=sk-of-your-ofox-key
# DOTHESIS_MODEL_ROUTE=ofox            # central brain route: native | ofox | openrouter
# ORCHESTRATOR_LLM_ROUTE=ofox          # engine (M1-M5 tools, auto-draft) route
# DOTHESIS_AGENT_MODEL=bailian/qwen-plus   # OPTIONAL — already the route's default.
#                                          # VN + markers + tools, 1M ctx, ~0.62x baseline.
# DOTHESIS_VISION_MODEL=gemini-2.5-flash   # vision turns: qwen is text-only, so
#                                          # image/screenshot calls use this Gemini/VL
#                                          # model via Ofox's Gemini-native endpoint.
# OpenRouter is a third route (DOTHESIS_MODEL_ROUTE=openrouter): OPENROUTER_API_KEY=...

# ===========================================================================
# OPTIONAL
# ===========================================================================

# --- Additional model providers ---
# ANTHROPIC_API_KEY=your-claude-api-key
# OPENAI_API_KEY=your-openai-api-key

# --- Gemini rate-limit resilience: fallback keys rotated on 429 ---
# GOOGLE_API_KEY_FALLBACK=
# GOOGLE_API_KEY_FALLBACK_2=
# GOOGLE_API_KEY_FALLBACK_3=

# --- Orchestrator (chat surface + M1-M5 auto-run). dev.sh defaults this true;
#     scripts/deploy.sh forces it true in the systemd unit. ---
ORCHESTRATOR_ENABLED=true
# Engine model. OPTIONAL — the default follows ORCHESTRATOR_LLM_ROUTE (native →
# gemini-2.5-flash, ofox → bailian/qwen-plus), so leaving this commented is always
# coherent. Set it only to pin a non-default model, and match the route's id style
# (ofox needs provider/model). See the routing block above.
# ORCHESTRATOR_LLM_MODEL=bailian/qwen-plus
# Postgres connection pool ceiling for the orchestrator checkpointer.
# ORCHESTRATOR_PG_POOL_MAX=10

# --- Partner report API (service-to-service "Powered by DoThesis") ---
# Shared secret for POST /api/v1/partner/report. Set the SAME value on the
# calling partner (e.g. Fillform's DOTHESIS_PARTNER_TOKEN). Empty = endpoint
# disabled (401 on every call). Requires ORCHESTRATOR_ENABLED=true.
# PARTNER_API_TOKEN=set-a-long-random-shared-secret

# --- Literature search providers (engine M2). All optional; each enables a
#     citation/search source. Without them, the engine uses its free defaults
#     (CrossRef / OpenAlex / arXiv). ---
# SEMANTIC_SCHOLAR_API_KEY=
# ENABLE_SEMANTIC_SCHOLAR=true
# SERPER_API_KEY=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# Polite-pool email sent to OpenAlex (improves rate limits).
# OPENALEX_EMAIL=you@example.com

# --- Transactional email (AWS SES). When the SES-specific keys are unset,
#     mail falls back to AWS_ACCESS_KEY / AWS_SECRET_KEY above. ---
# DOTHESIS_MAIL_FROM=noreply@yourdomain.com
# DOTHESIS_MAIL_REGION=ap-southeast-1
# AWS_SES_ACCESS_KEY=
# AWS_SES_SECRET_KEY=

# --- Payments ---
# Comma-separated providers to offer (e.g. "polar,paypal"). "dummy" stubs all
# providers for local dev (no real API calls / webhook verification).
# DOTHESIS_PAYMENTS=polar,paypal
# Polar
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_SERVER=sandbox            # or: production
# PayPal (raw REST)
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
# PAYPAL_MODE=sandbox             # or: production
# PAYPAL_WEBHOOK_ID=
# SePay (VietQR bank transfer — auto-offered to UTC+7 users when configured)
# In the SePay dashboard: Cấu hình Webhook → Phương thức xác thực = API Key,
# and put the same value here.
# SEPAY_API_KEY=                  # webhook auth: "Authorization: Apikey <key>"
#
# Two accounts are available; either works, pick ONE pair.
#  a) VietinBank — SePay's shared collection account. Transfers are routed by a
#     "SEVQR TKP " prefix the backend prepends to the code automatically.
# SEPAY_ACCOUNT_NUMBER=107868958175
# SEPAY_BANK_CODE=VietinBank
# SEPAY_BANK_NAME="VTB - Vietinbank"   # quote it: deploy.sh sources this file
#  b) OCB — per-merchant virtual account, no prefix needed.
# SEPAY_ACCOUNT_NUMBER=SEPFFR148620
# SEPAY_BANK_CODE=OCB
# SEPAY_BANK_NAME="OCB - Ngân hàng Phương Đông"
#
# Payment-code prefix: codes read DTS1234. These accounts are shared with
# Fillform (FFV codes) — keep the prefixes distinct or a transfer gets
# attributed to the wrong product. Configure the same prefix in SePay's
# Công ty → Cấu hình chung so its `code` field arrives pre-parsed.
# SEPAY_MEMO_PREFIX=DTS
# Webhook path below /api/v1. OVERRIDE IN PROD with a random string — the
# default is committed here, so it is obscure but not secret. Register the
# full URL in the SePay dashboard: https://<host>/api/v1/<this path>
# SEPAY_WEBHOOK_PATH=h00k/71204/cr3d1t
# USD_TO_VND=26300                # fixed FX rate for SePay package prices; not
#                                 # auto-tracked, re-check when the dong moves
# DOTHESIS_SIGNUP_BONUS_CREDITS=100

# --- Google Sign-In (frontend OAuth client id) ---
# DOTHESIS_GOOGLE_CLIENT_ID=

# --- Admin ---
# DOTHESIS_SUPER_ADMIN_EMAILS=you@example.com,teammate@example.com

# --- URLs / ports (defaults shown; override behind a reverse proxy) ---
# API_PORT=7100
# WEB_ORIGIN / DOTHESIS_BASE_URL are REQUIRED in any real deployment. They both
# default to http://localhost:3000, and leaving them unset does not break
# startup — it just mails verify / reset-password links pointing at localhost.
# WEB_ORIGIN=https://app.yourdomain.com
# DOTHESIS_BASE_URL=https://app.yourdomain.com
# Where the engine subprocess writes per-job working files.
# JOB_WORKDIR_ROOT=./var/jobs

# --- Agent research budget ---
# Wall clock for one research_scout deep search. On timeout the tool degrades to
# a light Crossref query rather than hanging the turn. The tool is sync, so this
# cap — not the headless profile's wall_clock_s — bounds a search in flight.
# DOTHESIS_SCOUT_TIMEOUT_S=120
# Wall clock for the LLM hop that translates a (Vietnamese) topic into an English
# Crossref query. On timeout the raw topic is searched instead.
# DOTHESIS_TRANSLATE_TIMEOUT_S=15

# --- Observability (LangSmith tracing) ---
# 1) Free key at https://smith.langchain.com/settings (5k traces/mo free tier).
# 2) In prod leave LANGSMITH_TRACING unset, or set LANGSMITH_SAMPLING_RATE=0.1.
# 3) Tracing failures never affect runtime (fire-and-forget).
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dothesis-dev
# LANGSMITH_TRACING=true            # dev.sh sets this when a key is present
# LANGSMITH_SAMPLING_RATE=0.1       # prod sampling
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # EU region override
